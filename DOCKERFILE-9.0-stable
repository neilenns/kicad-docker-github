FROM ubuntu:latest

ARG KICAD_VERSION=9.0

# Install dependencies for adding repositories, using as a devcontainer, and zipping workflow output
RUN apt update && apt install -y software-properties-common sudo openssh-client zip

# Install gh cli for access to automerge capabilities in a github workflow
RUN (type -p wget >/dev/null || (sudo apt update && sudo apt-get install wget -y)) \
	&& sudo mkdir -p -m 755 /etc/apt/keyrings \
        && out=$(mktemp) && wget -nv -O$out https://cli.github.com/packages/githubcli-archive-keyring.gpg \
        && cat $out | sudo tee /etc/apt/keyrings/githubcli-archive-keyring.gpg > /dev/null \
	&& sudo chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg \
	&& echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" | sudo tee /etc/apt/sources.list.d/github-cli.list > /dev/null \
	&& sudo apt update \
	&& sudo apt install gh -y

# Install KiCad and xvfb, but do not install docs or 3d models to save time and space. 3d models will come
# from the JLCPCB library.
RUN add-apt-repository -y ppa:kicad/kicad-${KICAD_VERSION}-releases && \
    apt update && \
    apt install -y --no-install-recommends \
    kicad \
    kicad-symbols \
    kicad-footprints

# Add xvfb so Interactive BOM plugin can be used in a non-interactive environment
RUN apt update && apt install xvfb -y

# Copy base library and settings into user folder  
ENV KICAD_CONFIG_DIR="/root/.config/kicad/${KICAD_VERSION}"
COPY kicad-base.json ${KICAD_CONFIG_DIR}/kicad.json
RUN mkdir -p "${KICAD_CONFIG_DIR}" && \
    cp /usr/share/kicad/template/*-lib-table "${KICAD_CONFIG_DIR}"

# Install latest JLCPCB library and KiCad plugins
RUN apt-get update && apt-get install -y \
    curl \
    unzip \
    jq \
    && rm -rf /var/lib/apt/lists/*
COPY install-plugins.sh /usr/local/bin/install-plugins.sh
RUN chmod +x /usr/local/bin/install-plugins.sh && \
    /usr/local/bin/install-plugins.sh && \
    rm /usr/local/bin/install-plugins.sh
COPY installed_packages.json ${KICAD_CONFIG_DIR}/

# Configure KiCad settings (disable auto-backup, etc.)
COPY kicad-settings-overrides.json /tmp/kicad-settings-overrides.json
COPY kicad-overrides.json /tmp/kicad-overrides.json
COPY configure-kicad-settings.sh /usr/local/bin/configure-kicad-settings.sh
RUN chmod +x /usr/local/bin/configure-kicad-settings.sh && \
    /usr/local/bin/configure-kicad-settings.sh /tmp/kicad-settings-overrides.json "${KICAD_CONFIG_DIR}/kicad_common.json" && \
    /usr/local/bin/configure-kicad-settings.sh /tmp/kicad-overrides.json "${KICAD_CONFIG_DIR}/kicad.json" && \
    rm /usr/local/bin/configure-kicad-settings.sh /tmp/kicad-settings-overrides.json /tmp/kicad-overrides.json

# Add plugin directory to Python path so build automation can run the plugins
ENV PYTHONPATH="/root/.local/share/kicad/${KICAD_VERSION}/3rdparty/plugins"

LABEL org.opencontainers.image.authors='Neil Enns' \
      org.opencontainers.image.url='https://github.com/neilenns/kicad-docker-github' \
      org.opencontainers.image.documentation='https://github.com/neilenns/kicad-docker-github' \
      org.opencontainers.image.source='https://github.com/neilenns/kicad-docker-github' \
      org.opencontainers.image.vendor='Neil Enns' \
      org.opencontainers.image.licenses='MIT' \
      org.opencontainers.image.description='Image with the KiCad Linux install and libraries available for GitHub workflow use'
